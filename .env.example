# Salin file ini menjadi .env lalu isi nilainya. JANGAN push .env ke GitHub.
# Alamat lengkap untuk memanggil flow audit_tool_description_integrity,
# salin dari contoh kode API di Langflow (biasanya berakhiran /api/v1/run/<id-flow>).
LANGFLOW_RUN_URL=ISI_ALAMAT_RUN_FLOW_DARI_LANGFLOW
LANGFLOW_API_KEY=ISI_API_KEY_LANGFLOW
# Opsional: lokasi database riwayat lokal
WG_DB_PATH=console_data.db
# Model LLM yang dipakai flow, versi dipin (BUKAN alias 'latest'). Dicatat oleh eval_v3.py.
MODEL_NAME=ISI_NAMA_MODEL_BERVERSI
